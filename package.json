{
  "name": "fart-attack",
  "version": "0.0.1",
  "private": true,
  "description": "Face-controlled arcade game powered by the Presage SmartSpectra SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:main": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist --entry-names=[name] --out-extension:.js=.cjs --external:electron --external:@smartspectra/node-sdk --log-level=warning",
    "build:renderer": "vite build --logLevel warn",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node scripts/launch.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "probe": "node --env-file-if-exists=.env tools/sdk-probe/probe.mjs",
    "snap": "npm run build && node scripts/launch.mjs --script scripts/snap.cjs",
    "verify:offline": "npm run build && node scripts/launch.mjs --script scripts/verify-offline.cjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "43.8.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "main": "dist/main.cjs"
}
